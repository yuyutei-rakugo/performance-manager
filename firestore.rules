rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function member() { return request.auth != null && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.active == true; }
  function editor() { return member() && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role in ['admin', 'editor']; }
  match /members/{uid} {
   allow get: if request.auth != null && request.auth.uid == uid;
   allow list, write: if false;
  }
  match /rehearsalAttendance/{rehearsalId}/responses/{uid} {
   allow read: if member();
   allow create, update: if member() && request.auth.uid == uid
    && request.resource.data.keys().hasAll(['stageName','status','updatedAt'])
    && request.resource.data.keys().hasOnly(['stageName','status','updatedAt'])
    && request.resource.data.stageName == get(/databases/$(database)/documents/members/$(request.auth.uid)).data.stageName
    && request.resource.data.status in ['出席','欠席','未定','未回答']
    && request.resource.data.updatedAt == request.time;
   allow delete: if false;
  }
  match /shared/{name} {
   allow read: if member() && name in ['events','history','rehearsals'];
   allow create: if editor() && name in ['events','history','rehearsals'] && request.resource.data.revision == 1 && valid();
   allow update: if editor() && name in ['events','history','rehearsals'] && request.resource.data.revision == resource.data.revision + 1 && valid();
   allow delete: if false;
   function valid() {
    return request.resource.data.keys().hasOnly(['items','revision','updatedBy','updatedAt'])
     && request.resource.data.items is list && request.resource.data.items.size() <= 500
     && request.resource.data.revision is int
     && request.resource.data.updatedBy == request.auth.uid
     && request.resource.data.updatedAt == request.time;
   }
  }
 }
}
